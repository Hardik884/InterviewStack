PORT=5000
MONGO_URI=
JWT_SECRET=
JWT_EXPIRES_IN=1d

# ── Redis ─────────────────────────────────────────────────────────────────
# Production: set REDIS_URL to the Upstash (or other) Redis instance.
# Format: rediss://default:<password>@<host>:<port>  (rediss:// = TLS)
# Required in production — the app refuses to silently fall back to
# localhost when NODE_ENV=production and REDIS_URL is unset.
REDIS_URL=

# Local development fallback — used only when REDIS_URL is not set.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_TTL_SECONDS=300

GEMINI_API_KEY=
RESUME_MAX_FILE_MB=10
JDOODLE_CLIENT_ID=
JDOODLE_CLIENT_SECRET=
JDOODLE_TIMEOUT_MS=10000
JDOODLE_CPU_TIME_LIMIT=2
LIVEKIT_WS_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
